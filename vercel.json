{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist/frontend/browser",
  "redirects": [
    { "source": "/", "destination": "/app", "permanent": false },
    { "source": "/recrutador", "destination": "/app/recrutador", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/app/:path*", "destination": "/index.html" }
  ]
}
